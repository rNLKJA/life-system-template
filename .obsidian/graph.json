{
  "collapse-filter": false,
  "search": "-path:/^(Scratch|External)\\// -[type:index] -[type:feed] -path:/^(?!README\\.md$)(?!(?:.*\\/)?([^\\/]+)\\/\\1\\.md$)(?:.*\\/)?(AGENTS|CLAUDE|MEMORY|LOG|TASKS|PROJECT|ARCHIVE|INBOX|CHANGELOG|CONVERSATION-LOG|STATUS|SOURCES|CATALOG|SKILL|SKILLS|VERSION|CONTRIBUTING|LICENSE|README)\\.md$/ -file:/\\.base$/",
  "showTags": false,
  "showAttachments": false,
  "hideUnresolved": true,
  "showOrphans": false,
  "collapse-color-groups": true,
  "colorGroups": [
    {
      "query": "path:/^Areas\\//",
      "color": {
        "a": 1,
        "rgb": 1752220
      }
    },
    {
      "query": "path:/^Projects\\//",
      "color": {
        "a": 1,
        "rgb": 3447003
      }
    },
    {
      "query": "path:/^HQ\\//",
      "color": {
        "a": 1,
        "rgb": 3066993
      }
    },
    {
      "query": "path:/^Knowledge\\//",
      "color": {
        "a": 1,
        "rgb": 10181046
      }
    },
    {
      "query": "path:/^Resources\\//",
      "color": {
        "a": 1,
        "rgb": 15844367
      }
    },
    {
      "query": "path:/^Archive\\//",
      "color": {
        "a": 1,
        "rgb": 9807270
      }
    }
  ],
  "collapse-display": true,
  "showArrow": false,
  "textFadeMultiplier": 0,
  "nodeSizeMultiplier": 1,
  "lineSizeMultiplier": 1,
  "collapse-forces": true,
  "centerStrength": 0.5,
  "repelStrength": 10,
  "linkStrength": 1,
  "linkDistance": 250,
  "scale": 0.5,
  "close": false
}
