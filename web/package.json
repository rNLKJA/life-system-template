{
  "name": "life-system-template",
  "version": "0.1.0",
  "private": true,
  "description": "A file-based life and work system for you and your AI agents",
  "scripts": {
    "dev": "next dev -p 3870",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "showcase": "playwright test --config playwright.config.ts --reporter=null",
    "showcase:test": "SHOWCASE_FAST=1 playwright test --config playwright.config.ts --reporter=null --headed",
    "showcase:media": "node scripts/showcase-media.mjs"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.42.1",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.0",
    "jsdom": "^23.0.1",
    "postcss": "^8.4.32",
    "prettier": "^3.1.1",
    "prettier-plugin-tailwindcss": "^0.5.7",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vitest": "^1.0.4"
  },
  "packageManager": "pnpm@10.33.1"
}
